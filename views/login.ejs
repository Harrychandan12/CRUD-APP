<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Student Management System</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&display=swap" rel="stylesheet">

<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Poppins,sans-serif;}

body{
  min-height:100vh;
  display:flex;
  justify-content:center;
  align-items:center;
  background:linear-gradient(135deg,#001f7d,#007bff,#36b3ff);
  overflow:hidden;
}

/* Background circles */
body::before{
  content:"";
  position:absolute;
  width:350px;height:350px;
  background:#4fc3ff55;
  border-radius:50%;
  top:-120px;right:-80px;
}

body::after{
  content:"";
  position:absolute;
  width:280px;height:280px;
  background:#4fc3ff33;
  border-radius:50%;
  bottom:-100px;left:-80px;
}

/* Decorative shapes */
.shape1,.shape2,.shape3{
  position:absolute;
  border-radius:50px;
  background:rgba(255,255,255,.18);
  filter:blur(1px);
}
.shape1{width:170px;height:30px;left:80px;top:180px;transform:rotate(40deg);}
.shape2{width:110px;height:25px;left:110px;top:250px;transform:rotate(40deg);}
.shape3{width:180px;height:35px;right:60px;bottom:180px;transform:rotate(-40deg);}

.card{
  width:430px;
  padding:28px;
  border-radius:28px;
  background:rgba(255,255,255,.12);
  backdrop-filter:blur(18px);
  border:1px solid rgba(255,255,255,.25);
  box-shadow:0 0 35px rgba(0,0,0,.35);
  color:white;
  z-index:2;
}

.title{
  text-align:center;
  margin-bottom:20px;
}
.title h1{font-size:28px;}
.title p{font-size:14px;color:#d7ebff;}

.tabs{
  display:flex;
  background:rgba(255,255,255,.15);
  border-radius:30px;
  margin:20px 0;
}

.tabs button{
  flex:1;
  padding:12px;
  border:none;
  border-radius:30px;
  background:transparent;
  color:white;
  font-weight:600;
  cursor:pointer;
}

.tabs .active{
  background:#002d9f;
}

.form{display:none;}
.form.active{display:block;}

input{
  width:100%;
  padding:14px;
  margin:10px 0;
  border:none;
  border-radius:12px;
  outline:none;
  background:white;
}

.submit{
  width:100%;
  padding:14px;
  margin-top:12px;
  border:none;
  border-radius:12px;
  background:#00a2ff;
  color:white;
  font-size:16px;
  font-weight:bold;
  cursor:pointer;
}

.forgot{
  color:#d8ecff;
  text-decoration:none;
  font-size:13px;
}

.or{
  text-align:center;
  margin:18px 0;
  color:#cfe7ff;
}

.social{
  display:flex;
  justify-content:center;
  gap:15px;
}
.social div{
  width:45px;height:45px;
  border-radius:50%;
  background:white;
  color:#0059c7;
  display:flex;
  justify-content:center;
  align-items:center;
  font-size:22px;
  font-weight:bold;
}
</style>
</head>

<body>

<div class="shape1"></div>
<div class="shape2"></div>
<div class="shape3"></div>

<div class="card">

  <div class="title">
    <h1>🎓 Student Management System</h1>
    <p>Learn • Grow • Succeed</p>
  </div>

  <div class="tabs">
    <button id="loginBtn" class="active" onclick="showLogin()">Sign In</button>
    <button id="registerBtn" onclick="showRegister()">Sign Up</button>
  </div>

  <!-- LOGIN -->
  <form action="/login" method="POST" id="loginForm" class="form active">
    <input type="email" name="email" placeholder="📧 Email Address" required>
    <input type="password" name="password" placeholder="🔒 Password" required>

    <a href="#" class="forgot">Forgot Password?</a>

    <button class="submit" type="submit">Sign In</button>
  </form>

  <!-- REGISTER -->
  <form action="/register" method="POST" id="registerForm" class="form">
    <input type="email" name="email" placeholder="📧 Enter Email" required>
    <input type="password" name="password" placeholder="🔒 Create Password" required>

    <button class="submit" type="submit">Create Account</button>
  </form>

  <div class="or">or continue with</div>

  <div class="social">
    <div>G</div>
    <div>GH</div>
    <div>f</div>
  </div>

</div>

<script>
const loginForm=document.getElementById("loginForm");
const registerForm=document.getElementById("registerForm");
const loginBtn=document.getElementById("loginBtn");
const registerBtn=document.getElementById("registerBtn");

function showLogin(){
  loginForm.classList.add("active");
  registerForm.classList.remove("active");
  loginBtn.classList.add("active");
  registerBtn.classList.remove("active");
}

function showRegister(){
  registerForm.classList.add("active");
  loginForm.classList.remove("active");
  registerBtn.classList.add("active");
  loginBtn.classList.remove("active");
}
</script>

</body>
</html>