<!DOCTYPE html>
<html>
<head>
  <title>Student Management</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="container mt-5">

  <h2 class="text-center text-primary">Student Registration Form</h2>

  <!-- ADD STUDENT -->
  <form action="/students" method="POST" class="mb-4">
    <input type="text" name="name" placeholder="Name" class="form-control mb-2" required />
    <input type="number" name="age" placeholder="Age" class="form-control mb-2" required />
    <input type="text" name="course" placeholder="Course" class="form-control mb-2" required />
    <input type="text" name="city" placeholder="City" class="form-control mb-2" required />

    <!-- Password -->
    <input type="password" name="password" placeholder="Admin Password" class="form-control mb-2" required />

    <button type="submit" class="btn btn-success">Add Student</button>
  </form>

  <h2 class="text-center text-info">Student List</h2>

  <table class="table table-bordered table-striped">
    <thead class="table-dark">
      <tr>
        <th>Name</th>
        <th>Age</th>
        <th>Course</th>
        <th>City</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% students.forEach(student => { %>
      <tr>
        <td><%= student.name %></td>
        <td><%= student.age %></td>
        <td><%= student.course %></td>
        <td><%= student.city %></td>

        <td>
          <!-- UPDATE -->
          <form action="/students/update/<%= student._id %>" method="POST" class="d-inline">
            <input type="text" name="name" value="<%= student.name %>" class="form-control mb-1" />
            <input type="number" name="age" value="<%= student.age %>" class="form-control mb-1" />
            <input type="text" name="course" value="<%= student.course %>" class="form-control mb-1" />
            <input type="text" name="city" value="<%= student.city %>" class="form-control mb-1" />

            <!-- Password -->
            <input type="password" name="password" placeholder="Admin Password" class="form-control mb-1" required />

            <button type="submit" class="btn btn-warning btn-sm">Update</button>
          </form>

          <!-- DELETE -->
          <form action="/students/delete/<%= student._id %>" method="POST" class="d-inline mt-1">
            <!-- Password -->
            <input type="password" name="password" placeholder="Admin Password" class="form-control mb-1" required />

            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>

</body>
</html>