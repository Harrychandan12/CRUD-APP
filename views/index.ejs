<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Management System</title>

  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:'Poppins',sans-serif;
    }

    body{
      background:linear-gradient(135deg,#001F7D,#005BFF,#3CC3FF);
      min-height:100vh;
      padding:20px;
      color:white;
      overflow-x:hidden;
    }

    body::before,body::after{
      content:"";
      position:fixed;
      border-radius:50%;
      background:rgba(255,255,255,.15);
      z-index:-1;
    }

    body::before{
      width:320px;
      height:320px;
      top:-100px;
      right:-100px;
    }

    body::after{
      width:260px;
      height:260px;
      bottom:-80px;
      left:-80px;
    }

    .glass{
      background:rgba(255,255,255,.12);
      backdrop-filter:blur(18px);
      border:1px solid rgba(255,255,255,.25);
      border-radius:25px;
      box-shadow:0 10px 30px rgba(0,0,0,.25);
    }

    h1{
      text-align:center;
      font-weight:700;
      margin-bottom:10px;
    }

    .subtitle{
      text-align:center;
      color:#d9edff;
      margin-bottom:25px;
    }

    input{
      border:none!important;
      border-radius:12px!important;
      padding:12px!important;
      margin-bottom:10px;
    }

    .table{
      color:white;
    }

    .table thead{
      background:#0038B8;
    }

    .table tbody tr:hover{
      background:rgba(255,255,255,.1);
    }

    .btn-success{
      background:#00C853;
      border:none;
    }

    .btn-warning{
      background:#FF9800;
      border:none;
      color:white;
    }

    .btn-danger{
      background:#E53935;
      border:none;
    }

    .btn{
      border-radius:10px;
    }

    .count-card{
      text-align:center;
      padding:15px;
      margin-bottom:20px;
    }

    .count-card h2{
      font-size:40px;
      font-weight:700;
      color:#00E5FF;
    }
  </style>
</head>

<body>

<div class="container">

  <h1>🎓 Student Management System</h1>
  <p class="subtitle">CRUD Web Application • Add • Update • Delete • Manage Students</p>

  <div class="glass count-card">
    <p>Total Registered Students</p>
    <h2><%= students.length %></h2>
  </div>

  <div class="glass p-4 mb-4">
    <h3 class="text-center mb-3">➕ Add New Student</h3>

    <form action="/students" method="POST">
      <input type="text" name="name" class="form-control" placeholder="👤 Student Name" required>

      <input type="number" name="age" class="form-control" placeholder="🎂 Age" required>

      <input type="text" name="course" class="form-control" placeholder="📚 Course" required>

      <input type="text" name="city" class="form-control" placeholder="🏙️ City" required>

      <input type="password" name="password" class="form-control" placeholder="🔒 Admin Password" required>

      <button class="btn btn-success w-100 mt-2">Add Student</button>
    </form>
  </div>

  <div class="glass p-4">
    <h3 class="text-center mb-3">📋 Registered Students</h3>

    <div class="table-responsive">
      <table class="table table-bordered text-center align-middle">
        <thead>
          <tr>
            <th>Name</th>
            <th>Age</th>
            <th>Course</th>
            <th>City</th>
            <th>Action</th>
          </tr>
        </thead>

        <tbody>
          <% students.forEach(student => { %>
          <tr>
            <td><%= student.name %></td>
            <td><%= student.age %></td>
            <td><%= student.course %></td>
            <td><%= student.city %></td>

            <td>
              <form action="/students/update/<%= student._id %>" method="POST">
                <input type="text" name="name" value="<%= student.name %>" class="form-control">
                <input type="number" name="age" value="<%= student.age %>" class="form-control">
                <input type="text" name="course" value="<%= student.course %>" class="form-control">
                <input type="text" name="city" value="<%= student.city %>" class="form-control">
                <input type="password" name="password" class="form-control" placeholder="Admin Password" required>

                <button class="btn btn-warning w-100 mt-2">✏️ Update</button>
              </form>

              <form action="/students/delete/<%= student._id %>" method="POST" class="mt-2">
                <input type="password" name="password" class="form-control" placeholder="Admin Password" required>

                <button class="btn btn-danger w-100 mt-2">🗑 Delete</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>

      </table>
    </div>
  </div>

</div>

</body>
</html>